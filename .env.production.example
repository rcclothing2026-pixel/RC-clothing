# Chiaco — PRODUCTION .env template.
# Upload ONCE to the server as  <account home>/chiiaco_app/.env  (via FTP),
# filled in with real values. The deploy NEVER creates or overwrites .env.

APP_NAME=Chiaco
APP_ENV=production
APP_KEY=                         # generate locally:  php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://chiiaco.com

APP_LOCALE=fa
APP_TIMEZONE=Asia/Tehran

# --- Database (create in cPanel → «مدیریت دیتابیس‌ها», then put the creds here) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chiiac_db            # cPanel usually prefixes with your account, e.g. chiiac_db
DB_USERNAME=chiiac_user
DB_PASSWORD=

# --- Sessions / cache / queue (DB-backed: no extra services needed on shared hosting) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database        # run the worker via cron (see scripts/DEPLOY.md)

# --- Search: keep OFF unless you run Meilisearch on the host ---
SCOUT_DRIVER=database            # 'database' = no Meili needed; switch to 'meilisearch' only if hosted

# --- Mail (use your cPanel mailbox / SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.chiiaco.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@chiiaco.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@chiiaco.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Payments (zarinpal etc. — set the real merchant id in admin or here as your gateway expects) ---
# ZARINPAL_MERCHANT_ID=

# --- StoqS integration (configure in admin → settings/integration, or here if used) ---
# STOQS_BASE_URL=
# STOQS_API_TOKEN=

# --- SMS (set in admin → پنل پیامک, or here). Melipayamak console = default: ---
# SMS_DRIVER=melipayamak_console
# SMS_CONSOLE_KEY=e070f58892e346a19254f48f58ddc17b      # orders/pattern key (/api/send/shared/<key>)
# SMS_CONSOLE_OTP_KEY=                                   # optional separate OTP key (blank = use above)
# SMS_CONSOLE_OTP_BODY_ID=                               # approved OTP pattern bodyId (one variable = the code)

# --- Telegram bot (set token + relay in admin → پنل تلگرام, or here) ---
# api.telegram.org is filtered in Iran; send via the Google Apps Script relay.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=ChiiacoBot
# TELEGRAM_RELAY_URL=https://script.google.com/macros/s/XXXX/exec
# TELEGRAM_RELAY_SECRET=
# Optional: send directly via a SOCKS/HTTP proxy instead of the relay
# TELEGRAM_PROXY=socks5://user:pass@host:1080

LOG_CHANNEL=stack
LOG_LEVEL=warning
