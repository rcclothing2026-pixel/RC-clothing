# Racket Club — PRODUCTION .env template (cPanel host, racketclub.ir).
# Upload ONCE to the server as  /home/chiiac/racketclub_app/.env  (via File
# Manager / FTP), filled in with real values. The deploy NEVER creates or
# overwrites .env. Never commit the filled-in file.

APP_NAME="Racket Club"
APP_ENV=production
APP_KEY=                         # generate locally:  php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://racketclub.ir

# Persian is the default storefront language (English is available via toggle).
APP_LOCALE=fa
APP_TIMEZONE=Asia/Tehran

# --- Database (cPanel → MySQL Databases; the account prefix is usually chiiac_) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chiiac_racketclub    # e.g. chiiac_racketclub after the cPanel prefix
DB_USERNAME=chiiac_rc
DB_PASSWORD=

# --- Sessions / cache / queue (DB-backed: no extra services on shared hosting) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database         # run the worker via cPanel cron (see the deploy guide)

# --- Product search: 'database' needs no Meilisearch service ---
SCOUT_DRIVER=database

# --- Mail (use a cPanel mailbox on the domain) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.racketclub.ir
MAIL_PORT=465
MAIL_USERNAME=no-reply@racketclub.ir
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@racketclub.ir
MAIL_FROM_NAME="${APP_NAME}"

# --- Payment gateway (Iranian) — set the real merchant id here or in admin ---
# ZARINPAL_MERCHANT_ID=
# ZIBAL_MERCHANT=

# --- SMS OTP provider (login is phone + code). Configure in admin or here. ---
# SMS_DRIVER=kavenegar            # kavenegar | smsir | melipayamak | log
# SMS_API_KEY=
# SMS_SENDER=
# SMS_OTP_TEMPLATE=

# --- Telegram bot (admin notifications; api.telegram.org is filtered in Iran,
#     so relay via the bundled Google Apps Script) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_RELAY_URL=
# TELEGRAM_RELAY_SECRET=

# --- Stock-keeping (StoqS) integration — wire when ready ---
# STOCKKEEPING_ENABLED=false
# STOCKKEEPING_BASE_URL=
# STOCKKEEPING_API_KEY=
# STOCKKEEPING_TENANT_ID=

LOG_CHANNEL=stack
LOG_LEVEL=warning
