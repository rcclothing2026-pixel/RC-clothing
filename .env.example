APP_NAME=Chiiaco
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Persian-first, RTL
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single

# Sentry error monitoring — empty DSN disables the SDK entirely (no-op).
# Get the DSN from https://sentry.io/ → Project Settings → Client Keys.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Production: MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chiiaco
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Payment gateways (ZarinPal, Zibal, Snapp Pay) ---
# Credentials are configured in the admin panel (Settings → Payment gateways),
# stored in the payment_methods table. No gateway env vars are required.

# --- SMS OTP provider: log | kavenegar | smsir | melipayamak ---
SMS_DRIVER=log
# Kavenegar / SMS.ir use an API key (+ template id/name)
SMS_API_KEY=
SMS_SENDER=
SMS_OTP_TEMPLATE=
# Melipayamak (shared-line bodyId / pattern) uses username + password + bodyId
SMS_USERNAME=
SMS_PASSWORD=
SMS_BODY_ID=

# --- StoqS (POS + inventory SaaS) integration ---
# System of record for stock, sales and CRM. The API key identifies the brand
# (tenant) and is bound server-side to the locations it may use.
STOCKKEEPING_ENABLED=false
STOCKKEEPING_BASE_URL=https://stoqs.ir
STOCKKEEPING_API_KEY=
# Locations this site mirrors, CSV of "<type>:<id>" (warehouse:1,shop:3).
# Storefront availability = SUM across these. Empty = whatever the key allows.
STOCKKEEPING_LOCATIONS=
# Which location a paid order is reported to / decremented from (one token above).
STOCKKEEPING_FULFILLMENT_LOCATION=
# Shared secret StoqS signs outbound webhooks with (X-Stoqs-Signature).
STOCKKEEPING_WEBHOOK_SECRET=
# Legacy/unused — the key identifies the tenant now.
STOCKKEEPING_TENANT_ID=
# Resilience tuning (optional — defaults shown below):
STOCKKEEPING_CACHE_TTL=120           # seconds to cache stock lookups
STOCKKEEPING_CIRCUIT_BREAKER=true    # enable circuit breaker
STOCKKEEPING_FAILURE_THRESHOLD=5     # failures before circuit opens
STOCKKEEPING_RESET_TIMEOUT=60        # seconds before retry

# --- Meilisearch (product search engine) ---
# Install: https://www.meilisearch.com/docs/learn/getting_started/quick_start
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# --- Telegram bot (admin notifications) ---
TELEGRAM_BOT_TOKEN=
